{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-zip-download",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "r2_buckets": [
    { "binding": "BUCKET",         "bucket_name": "portfolio-images" },
    { "binding": "PRIVATE_BUCKET", "bucket_name": "portfolio-images-private" }
  ],
  // D1 binding for the favorites/voting table
  // Secrets (set via wrangler secret put):
  //   ADMIN_SECRET — shared with Vercel WORKER_ADMIN_SECRET env var;
  //                  gates the /favorites/tally admin endpoint
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-favorites",
      "database_id": "b9c14753-3b58-4c85-974c-bbb7944857ae",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 300000
  }
}
