{
  "trailingSlash": true,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/gallery.html", "destination": "/personal-work/", "permanent": true },
    { "source": "/admin.html", "destination": "/admin/", "permanent": true },
    { "source": "/group/:id/", "destination": "/gallery/:id/", "permanent": true },
    { "source": "/group/:id", "destination": "/gallery/:id/", "permanent": true },
    {
      "source": "/album.html",
      "has": [{ "type": "query", "key": "id", "value": "(?<id>.*)" }],
      "destination": "/album/:id/",
      "permanent": true
    },
    {
      "source": "/album-group.html",
      "has": [{ "type": "query", "key": "id", "value": "(?<id>.*)" }],
      "destination": "/gallery/:id/",
      "permanent": true
    },
    { "source": "/curate.html", "destination": "/personal-work/", "permanent": true },
    { "source": "/curate-group.html", "destination": "/personal-work/", "permanent": true },
    { "source": "/fullalbums/", "destination": "/personal-work/", "permanent": true },
    { "source": "/fullalbums/:groupId/:slug/", "destination": "/gallery/:groupId/:slug/", "permanent": true },
    { "source": "/fullalbums/:groupId/:slug", "destination": "/gallery/:groupId/:slug/", "permanent": true },
    { "source": "/fullalbums/:id/", "destination": "/gallery/:id/", "permanent": true },
    { "source": "/fullalbums/:id", "destination": "/gallery/:id/", "permanent": true },
    { "source": "/gallery/", "destination": "/personal-work/", "permanent": false },
    { "source": "/client-work/", "destination": "/professional-work/", "permanent": true },
    { "source": "/client-work", "destination": "/professional-work/", "permanent": true },
    { "source": "/work/:category/", "destination": "/photos/:category/", "permanent": false },
    { "source": "/work/:category", "destination": "/photos/:category/", "permanent": false },
    { "source": "/archive/", "destination": "/personal-work/", "permanent": false },
    { "source": "/archive", "destination": "/personal-work/", "permanent": false },
    { "source": "/photos/travel/", "destination": "/personal-work/", "permanent": false },
    { "source": "/photos/travel", "destination": "/personal-work/", "permanent": false },
    { "source": "/photos/life/", "destination": "/gallery/misc-film-rolls-2026/", "permanent": false },
    { "source": "/photos/life", "destination": "/gallery/misc-film-rolls-2026/", "permanent": false },
    { "source": "/photos/couples/", "destination": "/photos/engagements/", "permanent": false },
    { "source": "/photos/couples", "destination": "/photos/engagements/", "permanent": false }
  ],
  "functions": {
    "api/gallery-shell.js": {
      "includeFiles": "{album/index.html,group/index.html,js/albums/*.js}"
    }
  },
  "rewrites": [
    { "source": "/family/", "destination": "/family/index.html" },
    { "source": "/familyalbums/", "destination": "/family/index.html" },
    { "source": "/familyalbums/:year/:slug/", "destination": "/api/gallery-shell?page=album&year=:year&slug=:slug" },
    { "source": "/familyalbums/:year/:slug", "destination": "/api/gallery-shell?page=album&year=:year&slug=:slug" },
    { "source": "/photos/:category/", "destination": "/portfolio/index.html" },
    { "source": "/photos/:category", "destination": "/portfolio/index.html" },
    { "source": "/personal-work/", "destination": "/personal-work/index.html" },
    { "source": "/professional-work/", "destination": "/professional-work/index.html" },
    { "source": "/unlock/", "destination": "/unlock/index.html" },
    { "source": "/gallery/:id/cities/", "destination": "/api/gallery-shell?page=group&id=:id" },
    { "source": "/gallery/:id/cities", "destination": "/api/gallery-shell?page=group&id=:id" },
    { "source": "/gallery/:id/places/", "destination": "/api/gallery-shell?page=group&id=:id" },
    { "source": "/gallery/:id/places", "destination": "/api/gallery-shell?page=group&id=:id" },
    { "source": "/gallery/:id/rolls/", "destination": "/api/gallery-shell?page=group&id=:id" },
    { "source": "/gallery/:id/rolls", "destination": "/api/gallery-shell?page=group&id=:id" },
    { "source": "/gallery/:id/albums/", "destination": "/api/gallery-shell?page=group&id=:id" },
    { "source": "/gallery/:id/albums", "destination": "/api/gallery-shell?page=group&id=:id" },
    { "source": "/gallery/:groupId/:slug/", "destination": "/api/gallery-shell?page=album&group=:groupId&slug=:slug" },
    { "source": "/gallery/:groupId/:slug", "destination": "/api/gallery-shell?page=album&group=:groupId&slug=:slug" },
    { "source": "/gallery/:id/", "destination": "/api/gallery-shell?page=group&id=:id" },
    { "source": "/gallery/:id", "destination": "/api/gallery-shell?page=group&id=:id" },
    { "source": "/album/:id/", "destination": "/api/gallery-shell?page=album&id=:id" },
    { "source": "/album/:id", "destination": "/api/gallery-shell?page=album&id=:id" }
  ]
}
